[Unit]
Description=PresenceMux Stream Deck
Documentation=https://github.com/jonas-meyer/presencemux
Wants=presencemuxd.socket
After=presencemuxd.socket
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/presencemux-deck
# Resets the deck after each stop. The deck then shows its own screen.
ExecStopPost=/usr/bin/presencemux-deck --reset
User=_presencemux-deck
Group=_presencemux-deck
SupplementaryGroups=presencemux
Restart=always
RestartSec=1s
WatchdogSec=5s
WatchdogSignal=SIGKILL
TimeoutStartSec=5s
TimeoutStartFailureMode=kill
TimeoutStopSec=2s

DevicePolicy=closed
DeviceAllow=char-hidraw rw
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RemoveIPC=yes
PrivateIPC=yes
IPAddressDeny=any
UMask=0077

[Install]
WantedBy=multi-user.target
