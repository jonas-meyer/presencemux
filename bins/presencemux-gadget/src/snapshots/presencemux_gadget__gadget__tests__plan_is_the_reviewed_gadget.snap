---
source: bins/presencemux-gadget/src/gadget.rs
expression: table
---
mkdir .
write idVendor = 0x1d6b
write idProduct = 0x0104
write bcdDevice = 0x0001
write bDeviceClass = 0xEF
write bDeviceSubClass = 0x02
write bDeviceProtocol = 0x01
write max_speed = high-speed
mkdir strings/0x409
write strings/0x409/manufacturer = PresenceMux
write strings/0x409/product = PresenceMux Studio
write strings/0x409/serialnumber = 0123456789abcdef
mkdir configs/c.1
mkdir configs/c.1/strings/0x409
write configs/c.1/strings/0x409/configuration = PresenceMux
write configs/c.1/bmAttributes = 0xC0
write configs/c.1/MaxPower = 100
mkdir functions/uvc.0
write functions/uvc.0/function_name = Studio Camera
write functions/uvc.0/streaming_maxpacket = 2048
write functions/uvc.0/streaming_interval = 1
mkdir functions/uvc.0/streaming/mjpeg/m
mkdir functions/uvc.0/streaming/mjpeg/m/1080p
write functions/uvc.0/streaming/mjpeg/m/1080p/wWidth = 1920
write functions/uvc.0/streaming/mjpeg/m/1080p/wHeight = 1080
write functions/uvc.0/streaming/mjpeg/m/1080p/dwFrameInterval = 333333
write functions/uvc.0/streaming/mjpeg/m/1080p/dwDefaultFrameInterval = 333333
write functions/uvc.0/streaming/mjpeg/m/1080p/dwMinBitRate = 165888000
write functions/uvc.0/streaming/mjpeg/m/1080p/dwMaxBitRate = 331776000
write functions/uvc.0/streaming/mjpeg/m/1080p/dwMaxVideoFrameBufferSize = 4147200
mkdir functions/uvc.0/streaming/header/h
link functions/uvc.0/streaming/header/h/m -> functions/uvc.0/streaming/mjpeg/m
link functions/uvc.0/streaming/class/fs/h -> functions/uvc.0/streaming/header/h
link functions/uvc.0/streaming/class/hs/h -> functions/uvc.0/streaming/header/h
link functions/uvc.0/streaming/class/ss/h -> functions/uvc.0/streaming/header/h
mkdir functions/uvc.0/control/header/h
link functions/uvc.0/control/class/fs/h -> functions/uvc.0/control/header/h
link functions/uvc.0/control/class/ss/h -> functions/uvc.0/control/header/h
link configs/c.1/uvc.0 -> functions/uvc.0
mkdir functions/uac2.mic
write functions/uac2.mic/p_srate = 48000
write functions/uac2.mic/c_srate = 48000
write functions/uac2.mic/p_ssize = 2
write functions/uac2.mic/c_ssize = 2
write functions/uac2.mic/c_sync = async
write functions/uac2.mic/p_mute_present = 0
write functions/uac2.mic/p_volume_present = 0
write functions/uac2.mic/c_mute_present = 0
write functions/uac2.mic/c_volume_present = 0
write functions/uac2.mic/req_number = 4
write functions/uac2.mic/p_chmask = 1
write functions/uac2.mic/c_chmask = 0
write functions/uac2.mic/function_name = Studio Microphone
write functions/uac2.mic/if_ctrl_name = Studio Microphone
write functions/uac2.mic/p_it_name = Studio Microphone
link configs/c.1/uac2.mic -> functions/uac2.mic
mkdir functions/uac2.spk
write functions/uac2.spk/p_srate = 48000
write functions/uac2.spk/c_srate = 48000
write functions/uac2.spk/p_ssize = 2
write functions/uac2.spk/c_ssize = 2
write functions/uac2.spk/c_sync = async
write functions/uac2.spk/p_mute_present = 0
write functions/uac2.spk/p_volume_present = 0
write functions/uac2.spk/c_mute_present = 0
write functions/uac2.spk/c_volume_present = 0
write functions/uac2.spk/req_number = 4
write functions/uac2.spk/p_chmask = 0
write functions/uac2.spk/c_chmask = 3
write functions/uac2.spk/function_name = Studio Audio
write functions/uac2.spk/if_ctrl_name = Studio Audio
write functions/uac2.spk/c_ot_name = Studio Audio
link configs/c.1/uac2.spk -> functions/uac2.spk
