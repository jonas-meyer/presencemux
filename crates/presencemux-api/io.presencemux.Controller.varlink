#  Controls the privacy of the camera and the microphone.
interface io.presencemux.Controller

#  The state of the cam plane. A cam value is `blank`, `live` or a slate name.
type CamStatus (#  The value that the user asked for.
requested: string, #  The value that the controller grants the cam worker.
granted: string, #  The frames that the host gets, as the cam worker reports them. `nothing`
#  means no stream. Null without a fresh report.
actual: ?string, #  What the host can get without a press. Null without a fresh report.
exposure: ?Exposure, #  The name of the slate of `exposure`. Null for another exposure, or for a
#  slate without a name in the configuration.
slate: ?string, #  Whether the host gets the exposure now. Null without a fresh report.
flow: ?Flow, #  Why the exposure differs from the request. Null if it does not.
reason: ?Reason, #  Why automation holds the plane at blank. Null after the user sets the
#  plane.
hold: ?Cause, #  Whether `Resume` applies the request again now.
resumable: bool, #  Whether the host receives the stream of the cam worker.
stream: CamStream, #  The time at which the stream timeout sets the cam to blank, in
#  `CLOCK_MONOTONIC` microseconds. Null unless the host receives no stream
#  while the exposure is above off.
blankAtUSec: ?int)

#  Whether the host receives the stream of the cam worker.
type CamStream (idle, streaming)

#  The state of the mic plane.
type MicStatus (#  The value that the user asked for.
requested: Mute, #  Whether the controller lets the gate pass audio.
granted: Permission, #  The audio that the host gets, as the audio worker reports it. Null
#  without a fresh report.
actual: ?MicOutput, #  What the host can get without a press. Null without a fresh report.
exposure: ?Exposure, #  Whether the host gets the exposure now. Null without a fresh report.
flow: ?Flow, #  Why the exposure differs from the request. Null if it does not.
reason: ?Reason, #  Why automation holds the plane at muted. Null after the user sets the
#  plane.
hold: ?Cause, #  Whether `Resume` applies the request again now.
resumable: bool)

#  The audio that the host gets.
type MicOutput (
	#  The gate writes digital silence.
	silent,
	#  The gate passes audio with a falling gain, after a lease that closes
	#  the gate.
	closing,
	#  The gate passes audio while it opens or is open.
	passing
)

#  The state of a worker that owns devices.
type OwnerStatus (owner: Owner, report: ReportState, #  The time of the last change of `report`, in `CLOCK_MONOTONIC`
#  microseconds.
sinceUSec: int, devices: []DeviceCondition, #  The rejection or the detail in the last report of the worker.
message: ?string)

#  A worker that owns devices.
type Owner (cam_worker, audio_worker)

#  Whether the controller has a fresh report of a worker.
type ReportState (
	#  No report since the start of the daemon.
	pending,
	fresh,
	#  The worker does not reply, or sends no more reports.
	lost
)

#  The condition of a device.
type DeviceCondition (device: Device, status: DeviceStatus, #  The time of the last change of `status`, in `CLOCK_MONOTONIC`
#  microseconds.
sinceUSec: int)

#  A device that a worker owns.
type Device (camera, cam_worker, audio_interface, gate)

#  The status of a device. `unknown` means that the controller has no fresh
#  report of its worker. The variants are in order from the best to the worst.
type DeviceStatus (ready, initializing, missing, unknown, fault)

#  Whether the user wants the mic muted.
type Mute (muted, unmuted)

#  Whether the gate may pass audio.
type Permission (denied, permitted)

#  A privacy plane.
type Plane (cam, mic)

#  What the host can get from a plane without a press. The exposure is the
#  higher of the actual output and the grant that the worker applies. A
#  latched worker exposes only its actual output.
type Exposure (off, slate, live)

#  Whether the host gets the exposure of a plane now.
type Flow (
	flowing,
	#  The host gets less than the exposure, for example because no app reads
	#  the stream.
	idle
)

#  Why the exposure of a plane differs from its request.
type Reason (
	#  Automation holds the plane. `hold` gives the cause.
	held,
	#  The worker applies an older grant.
	updating,
	#  The latch of the worker blocks the grant.
	blocked,
	#  The controller grants less than the request, for example while a
	#  device is not ready.
	waiting
)

#  A preset and the values that it sets. A missing value leaves its plane as it
#  is.
type PresetValues (name: string, #  `blank`, `live` or a slate name.
cam: ?string, mic: ?Mute)

#  The state of the USB connection to the host.
type Host (disconnected, suspended, connected)

#  The health of the devices. `degraded` means that a device is missing or
#  not ready yet, or that a worker has not reported yet.
type Health (ready, degraded, fault)

#  Why automation lowered a plane.
type Cause (
	camera_fault,
	cam_worker_fault,
	#  The daemon has no contact with the cam worker.
	cam_worker_lost,
	#  The cam worker sends a frame above the grant under which it queued the
	#  frame.
	cam_output_exceeded,
	audio_interface_fault,
	gate_fault,
	#  The daemon has no contact with the audio worker.
	audio_worker_lost,
	#  The gate passes audio without a grant that permits it.
	mic_output_exceeded,
	controller_stalled,
	host_disconnected,
	host_suspended,
	host_connected,
	stream_stopped
)

#  Returns the status.
method Describe() -> (cam: CamStatus, mic: MicStatus, #  The workers that own the devices, with the conditions of the devices.
owners: []OwnerStatus, host: Host, health: Health, #  The last preset that the user applied. Null after the user changes a
#  single plane.
preset: ?string)

#  Returns the status, then the status after each change. Without `more`,
#  it returns the status once.
method SubscribeStatus() -> (cam: CamStatus, mic: MicStatus, #  The workers that own the devices, with the conditions of the devices.
owners: []OwnerStatus, host: Host, health: Health, #  The last preset that the user applied. Null after the user changes a
#  single plane.
preset: ?string)

#  Applies `privacy` or a configured preset.
method ApplyPreset(name: string) -> ()

#  Sets the cam to `blank`, `live` or a slate name.
method SetCam(cam: string) -> ()

#  Mutes or unmutes the mic.
method SetMicMute(muted: bool) -> ()

#  Applies the request of a held plane again. The devices of the plane must
#  be ready, and the host must be connected. Otherwise the method does
#  nothing.
method Resume(plane: Plane) -> ()

#  Returns each preset with its values: first the built-in `privacy`, then
#  the configured presets.
method ListPresets() -> (presets: []PresetValues)

#  The preset is not `privacy` or a configured preset.
error NoSuchPreset ()

#  The cam value is not `blank`, `live` or a configured slate.
error NoSuchSlate ()

#  The daemon has too many requests to handle. Try again.
error TooManyRequests ()

#  The daemon cannot handle requests at this time.
error NotAvailable ()